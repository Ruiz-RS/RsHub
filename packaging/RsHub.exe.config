<?xml version="1.0" encoding="utf-8"?>
<!--
  Read by .NET Framework when RsHub.exe loads it (pythonnet runs the window and the tray through it).

  When the portable .zip is extracted with Windows Explorer, every file gets the "downloaded from the internet"
  mark, and .NET Framework then refuses to load _internal\pythonnet\runtime\Python.Runtime.dll: RsHub stopped
  at start with "Failed to resolve Python.Runtime.Loader.Initialize". This setting lets it load its own assemblies
  from its own folder; it is Microsoft's documented switch for that case
  (https://learn.microsoft.com/dotnet/framework/configure-apps/file-schema/runtime/loadfromremotesources-element).
-->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
